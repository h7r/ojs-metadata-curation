msgstr "Suggestion (proposed, editable)"

msgid "plugins.generic.nvMetadataCuration.mode.choice"
msgstr "Choice (mandatory thesaurus selection)"

msgid "plugins.generic.nvMetadataCuration.mode.bypass"
msgstr "Bypass (free text with warning)"

