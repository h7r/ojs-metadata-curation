msgid "plugins.generic.nvMetadataCuration.audit.description"
msgstr "Vue d'ensemble de la conformité des champs de métadonnées par soumission. Vert = complet, orange = partiel, rouge = manquant."

msgid "plugins.generic.nvMetadataCuration.audit.noSubmissions"
msgstr "Aucune soumission trouvée pour cette revue."

msgid "plugins.generic.nvMetadataCuration.audit.tableLabel"
msgstr "Conformité des métadonnées par soumission"

msgid "plugins.generic.nvMetadataCuration.audit.colTitle"
msgstr "Soumission"

