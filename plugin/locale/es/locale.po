msgid "plugins.generic.nvMetadataCuration.displayName"
msgstr "NV Curación de metadatos"

msgid "plugins.generic.nvMetadataCuration.description"
msgstr "Búsqueda en vocabularios controlados para campos de metadatos OJS mediante tesauros SPARQL (UNESCO, Rameau, Eurovoc). Incluye búsqueda de ORCID/ROR con validación humana."

msgid "plugins.generic.nvMetadataCuration.settings.thesauri"
msgstr "Tesauros"

msgid "plugins.generic.nvMetadataCuration.settings.thesauriDescription"
msgstr "Seleccione los tesauros disponibles para la búsqueda de palabras clave en esta revista."

msgid "plugins.generic.nvMetadataCuration.thesaurus.unesco"
msgstr "Tesauro UNESCO"

msgid "plugins.generic.nvMetadataCuration.thesaurus.rameau"
msgstr "Rameau (BnF)"

msgid "plugins.generic.nvMetadataCuration.thesaurus.eurovoc"
msgstr "Eurovoc (UE)"

msgid "plugins.generic.nvMetadataCuration.settings.interactionMode"
msgstr "Modo de interacción"

msgid "plugins.generic.nvMetadataCuration.settings.interactionModeDescription"
msgstr "Controla cómo se presentan las sugerencias de palabras clave a los autores."

msgid "plugins.generic.nvMetadataCuration.mode.suggestion"
msgstr "Sugerencia (propuesta, editable)"

msgid "plugins.generic.nvMetadataCuration.mode.choice"
msgstr "Elección (selección obligatoria del tesauro)"

msgid "plugins.generic.nvMetadataCuration.mode.bypass"
msgstr "Libre (texto libre con advertencia)"

msgid "plugins.generic.nvMetadataCuration.settings.apiKey"
msgstr "Clave API NV"

msgid "plugins.generic.nvMetadataCuration.settings.apiKeyLabel"
msgstr "Clave API"

msgid "plugins.generic.nvMetadataCuration.settings.apiKeyDescription"
msgstr "Introduzca su clave API de Ne Varietur para acceso ilimitado. Sin clave, el plugin está limitado a 50 solicitudes por día."

