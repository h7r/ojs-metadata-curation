msgstr "Auditoría de metadatos"

msgid "plugins.generic.nvMetadataCuration.audit.description"
msgstr "Visión general de la conformidad de los campos de metadatos en los envíos. Verde = completo, naranja = parcial, rojo = faltante."

msgid "plugins.generic.nvMetadataCuration.audit.noSubmissions"
msgstr "No se encontraron envíos para esta revista."

msgid "plugins.generic.nvMetadataCuration.audit.tableLabel"
msgstr "Conformidad de metadatos por envío"

msgid "plugins.generic.nvMetadataCuration.audit.colTitle"
msgstr "Envío"

msgid "plugins.generic.nvMetadataCuration.audit.colKwdCurated"
msgstr "Palabras clave curadas"

msgid "plugins.generic.nvMetadataCuration.audit.colKwdOjs"
msgstr "Palabras clave OJS"

msgid "plugins.generic.nvMetadataCuration.audit.colOrcid"
msgstr "ORCID"

msgid "plugins.generic.nvMetadataCuration.audit.colAffiliation"
